LOCAL_URL=http://localhost:8080
WEB_PORT=8080
DB_PORT=3307
PHPMYADMIN_PORT=8081
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

WEB_CONTAINER=papelito-web
DB_CONTAINER=papelito-db
PHPMYADMIN_CONTAINER=papelito-phpmyadmin
MAILPIT_CONTAINER=papelito-mailpit

DB_NAME=papelito_local
DB_USER=papelito
DB_PASSWORD=papelito_local_123
DB_ROOT_PASSWORD=root_local_123
DB_HOST=db
DB_CHARSET=utf8

WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_ENVIRONMENT_TYPE=local
WP_MEMORY_LIMIT=256M
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
DISALLOW_FILE_EDIT=false
ALLOW_UNFILTERED_UPLOADS=true
FS_METHOD=direct

DEPLOY_THEME_SLUG=jupiterx-child
DEPLOY_PLUGIN_SLUG=plugin_papelito
REMOTE_HOST=
REMOTE_PORT=22
REMOTE_USER=
REMOTE_THEMES_DIR=/home/USER/public_html/wp-content/themes
REMOTE_PLUGINS_DIR=/home/USER/public_html/wp-content/plugins
REMOTE_MU_PLUGINS_DIR=/home/USER/public_html/wp-content/mu-plugins
REMOTE_WP_PATH=/home/USER/public_html
REMOTE_BACKUP_DIR=/home/USER/backups/papelito
REMOTE_FLUSH_CACHE=true
BACKUP_DATABASE=true

# === Hardening (Sprint 0) ===
DISALLOW_FILE_MODS=true
FORCE_SSL_ADMIN=true
FORCE_SSL_LOGIN=true
WP_CACHE=false
AUTO_UPDATER_DISABLED=false

# === Headless (Sprint 1) ===
GRAPHQL_JWT_AUTH_SECRET_KEY=
GRAPHQL_WOOCOMMERCE_SECRET_KEY=
PAPELITO_FRONTEND_URL=http://localhost:3000
PAPELITO_ALLOWED_ORIGINS=https://papelitobrasil.com.br,http://localhost:3000
PAPELITO_FRONT_PROXY_TOKEN=
COOKIE_DOMAIN=
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASS=
# Core API v5. Para chaves de teste, valide no Dashboard/docs se sua conta deve usar sdx-api.
PAGARME_BASE_URL=https://api.pagar.me/core/v5
# Simulador local/teste de webhooks Pagar.me. Nunca habilitar em production.
PAPELITO_PAGARME_SIMULATION_ENABLED=false
PAPELITO_PAGARME_SIMULATION_TOKEN=

# === Correios Headless Shipping ===
PAPELITO_CORREIOS_USERNAME=
PAPELITO_CORREIOS_ACCESS_CODE=
PAPELITO_CORREIOS_POSTING_CARD=
PAPELITO_CORREIOS_CONTRACT=
PAPELITO_CORREIOS_ENV=production
# disabled|mock|real. Mock so funciona em WP_ENVIRONMENT_TYPE=local|development.
PAPELITO_CORREIOS_PREPOST_MODE=disabled
# success|400|401|403|404|409|422|429|500|503 (somente modo mock).
PAPELITO_CORREIOS_PREPOST_MOCK_SCENARIO=success
# Habilita cadastro de S10 pelo vendor quando a etiqueta e gerada externamente.
PAPELITO_CORREIOS_MANUAL_TRACKING_ENABLED=false
# No modo mock, controla a saude sem criar pre-postagem real: mock|real.
PAPELITO_CORREIOS_DEV_HEALTH_SOURCE=mock
# healthy|unhealthy|unknown quando a fonte de saude e mock.
PAPELITO_CORREIOS_DEV_HEALTH_SCENARIO=healthy
# preposted|posted|in_transit|delivered|cancelled|expired.
PAPELITO_CORREIOS_DEV_TRACKING_SCENARIO=preposted

# Chaves de PII. Gere valores fortes com `openssl rand -hex 32` e coloque APENAS no .env local
# (gitignored) e no cofre/ambientes. Nunca commitar os valores reais nem usar em NEXT_PUBLIC_*.
PAPELITO_PII_LOOKUP_KEY=change-me
PAPELITO_PII_ENCRYPTION_KEY=change-me
# Versao da chave de cifra (para rotacao). Chaves anteriores ficam em
# PAPELITO_PII_ENCRYPTION_KEY_V<n> enquanto houver dados a re-encriptar.
PAPELITO_PII_KEY_VERSION=1
# Tokens comerciais dos providers de CNPJ (opcionais; sem eles operam em modo publico/dev).
PAPELITO_CNPJWS_TOKEN=
PAPELITO_RECEITAWS_TOKEN=
# Feature flags do modelo B2B. TODAS desligadas na Fase 0 (fonte autoritativa server-side).
PAPELITO_B2B_COMPANY_MODEL_ENABLED=false
PAPELITO_B2B_PURCHASE_ENFORCED=false
PAPELITO_COMPANY_MANUAL_APPROVAL_ENABLED=false
PAPELITO_QSA_AUTO_APPROVE_ENABLED=false
PAPELITO_ALPHANUMERIC_CNPJ_ENABLED=false
# Nao ligar sem confirmacao oficial da Pagar.me sobre CNPJ alfanumerico (chamado/sandbox).
PAPELITO_ALPHANUMERIC_CNPJ_PAYMENT_ENABLED=false
